{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/site/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bodoni Moda|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Bodoni Moda, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|index|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, index, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ink|cream|amber|red|ghost)$/]",
        "message": "<Button> variant must be one of 'ink' | 'cream' | 'amber' | 'red' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|right|center|size|rule|key|ref|className|style|children)$/]",
        "message": "<DisplayRow> doesn't accept that prop. Declared props: left, right, center, size, rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|tone|children|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: as, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|muted|inverse)$/]",
        "message": "<Label> tone must be one of 'primary' | 'muted' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<MetaBarItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|index|tone|height|key|ref|className|style|children)$/]",
        "message": "<NavTile> doesn't accept that prop. Declared props: label, index, tone, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|amber|red|ink)$/]",
        "message": "<NavTile> tone must be one of 'cream' | 'amber' | 'red' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|ink)$/]",
        "message": "<Rule> tone must be one of 'soft' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:first|last|size|split|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: first, last, size, split."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "DisplayRow": {
        "replaces": []
      },
      "Label": {
        "replaces": []
